# Environment variables
.env
*.env

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# macOS
.DS_Store

# ── Model Training Data ───────────────────────────────────────
# Exclude cloned repos (data/raw) — too large for GitHub (918MB)
# Clone them locally using: ./scripts/clone_repos.sh
model-training/data/raw/

# Exclude intermediate markdown (regenerated by pdf_to_md.py)
model-training/data/markdown/

# Exclude cleaned markdown (regenerated by clean_markdown.py)
model-training/data/cleaned/

# Exclude combined JSONL (regenerated by dataset_split.py)
model-training/data/datasets/combined.jsonl

# ── Keep (tracked by git) ─────────────────────────────────────
# model-training/scripts/          ← all pipeline scripts
# model-training/configs/          ← training configs
# model-training/README.md         ← documentation
# model-training/requirements.txt  ← dependencies
# model-training/data/datasets/train.jsonl   ← final dataset
# model-training/data/datasets/val.jsonl
# model-training/data/datasets/test.jsonl

# Jupyter notebook checkpoints
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Model weights and checkpoints
model-training/models/
model-training/outputs/
*.safetensors
*.bin
*.gguf
*.ggml

